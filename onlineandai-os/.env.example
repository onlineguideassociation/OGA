# Server
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/onlineguide

# JWT
JWT_SECRET=replace-me

# AI Providers
OPENAI_KEY=
GEMINI_KEY=
ANTHROPIC_KEY=

# WordPress (onlineguideassociation.org)
# Generate at: WP Admin > Users > Profile > Application Passwords
WP_URL=https://onlineguideassociation.org
WP_USERNAME=
WP_APP_PASSWORD=

# AWS (S3 + SES)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
SES_FROM_EMAIL=noreply@onlineguideassociation.org

# Google Business Profile
# OAuth2 access token (refresh with oauth2 flow)
GBP_ACCESS_TOKEN=

# WhatsApp Business Cloud API
# Meta Developer Portal > WhatsApp > Configuration
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# Meta / Facebook Ads
META_PAGE_TOKEN=
META_PAGE_ID=
META_AD_ACCOUNT_ID=

# TikTok for Business
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# Stripe
# Register webhook at: dashboard.stripe.com/webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLIC_KEY=

# ── Cambodian Payment Gateways ───────────────────────────────────────────────

# ABA PayWay (ABA Bank)
# Register at: https://merchant.payway.com.kh
# Get Merchant ID + API Key from ABA merchant portal
ABA_MERCHANT_ID=
ABA_API_KEY=
# Your public-facing URL for ABA redirects (e.g. https://yourdomain.com)
FRONTEND_URL=https://onlineguideassociation.org

# Wing Pay
# Register at: https://developers.wingmoney.com
WING_MERCHANT_ID=
WING_SECRET_KEY=
WING_ACCESS_TOKEN=

# Bakong / KHQR (National Bank of Cambodia)
# Register at: https://bakong.nbc.gov.kh (NBC Bakong merchant portal)
# BAKONG_MERCHANT_ID format: yourname@yourbank  e.g. onlineguide@abaakhpp
BAKONG_API_TOKEN=
BAKONG_MERCHANT_ID=onlineguide@abaakhpp
BAKONG_MERCHANT_NAME=OnlineGuide Tours
BAKONG_WEBHOOK_SECRET=

# ── WooCommerce REST API ─────────────────────────────────────────────────────
# Generate at: WP Admin > WooCommerce > Settings > Advanced > REST API
# Set Permission to: Read/Write
# WP_URL is reused from WordPress section above
WC_CONSUMER_KEY=ck_
WC_CONSUMER_SECRET=cs_
# Webhook secret (set when creating WC webhooks)
WC_WEBHOOK_SECRET=
